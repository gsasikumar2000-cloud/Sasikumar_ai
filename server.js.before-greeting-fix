app.get("/api/breaking-news", async (req, res) => {
  try {
    const category = String(req.query.category || "Tamil Nadu").trim();

    const language = String(req.query.language || "ta").toLowerCase();

    const languageNames = {
      ta: "Tamil",
      en: "English",
      hi: "Hindi",
      te: "Telugu",
      kn: "Kannada",
      ml: "Malayalam"
    };

    const langName = languageNames[language] || "Tamil";

    const query =
      `${category} latest breaking news today ${langName}`;

    if (!process.env.TAVILY_API_KEY) {
      return res.status(503).json({
        ok: false,
        reply: "⚠️ Live News service தற்போது கிடைக்கவில்லை."
      });
    }

    const tvly = tavily({
      apiKey: process.env.TAVILY_API_KEY
    });

    const data = await tvly.search(query, {
      search_depth: "basic",
      max_results: 8,
      include_answer: true
    });


    const results = Array.isArray(data.results)
      ? data.results.map((item, index) => ({
          number: index + 1,
          title: item.title || "முக்கிய செய்தி",
          url: item.url || "",
          content: item.content || "",
          published: item.published_date || ""
        }))
      : [];

    // Remove repeated Live News headlines and URLs.
    const seenNewsUrls = new Set();
    const seenNewsTitles = new Set();
    const uniqueNewsResults = results.filter(item => {
      const url = String(item.url || "").trim()
        .replace(/[?#].*$/, "").replace(/\/+$/, "").toLowerCase();
      const title = String(item.title || "").toLowerCase()
        .replace(/\s+/g, " ").trim();
      if ((url && seenNewsUrls.has(url)) ||
          (title && seenNewsTitles.has(title))) return false;
      if (url) seenNewsUrls.add(url);
      if (title) seenNewsTitles.add(title);
      return true;
    });
    uniqueNewsResults.forEach((item, index) => {
      item.number = index + 1;
    });

    res.json({
      ok: true,
      language,
      languageName: langName,
      category,
      query,
      answer: data.answer || "",
      count: uniqueNewsResults.length,
      news: uniqueNewsResults,
      source: "Tavily Web Search",
      updatedAt: new Date().toISOString()
    });

  } catch (e) {
    console.error("Breaking News Error:", e);
    res.status(500).json({
      ok: false,
      error: e.message || String(e),
      name: e.name || "Error",
      reply: "❌ தமிழ் நேரலை செய்திகள் பெறுவதில் சிக்கல் ஏற்பட்டது."
    });
  }
});

