<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Live Gold & Silver | SASIKUMAR AI</title>
<style>
*{box-sizing:border-box}
body{margin:0;padding:16px;background:#f1f5f9;color:#172033;font-family:Arial,sans-serif}
.wrap{max-width:760px;margin:auto}
header,.panel{background:white;border-radius:18px;padding:18px;margin-bottom:14px;box-shadow:0 5px 20px #0000000c}
.brand{display:flex;align-items:center;justify-content:center;gap:12px;text-align:left}
.brand img{width:60px;height:60px;object-fit:contain}
h1{font-size:clamp(20px,5vw,30px);margin:0}
.sub{text-align:center;color:#536174;margin-top:12px}
.meta{text-align:center;font-size:14px;line-height:1.8;margin-top:12px}
.rates{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.rate{padding:17px 12px;border-radius:15px;background:#fff9e7;border:1px solid #f2d88b;overflow-wrap:anywhere}
.rate.silver{background:#f1f5f9;border-color:#cbd5e1}
.rate h2{font-size:17px;margin:0 0 10px}
.price{font-size:clamp(21px,5vw,30px);font-weight:800}
.unit{font-size:13px;color:#64748b;margin-top:6px}
.actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:16px}
button,.link{border:0;border-radius:11px;padding:12px 8px;font-weight:700;font-size:14px;cursor:pointer;text-align:center;text-decoration:none}
.preview{background:#155eab;color:white}
.share{background:#167d3e;color:white}
.print{background:#334155;color:white}
.save{background:#7c3aed;color:white}
.close{background:#b42323;color:white}
.home{background:#0f766e;color:white}
#poster{width:100%;height:auto;display:block;border-radius:12px;background:white}
#status{font-size:14px;text-align:center;line-height:1.6;color:#475569}
footer{text-align:center;padding:12px;color:#64748b;font-size:12px}
@media(max-width:420px){body{padding:9px}.rates{grid-template-columns:1fr}.actions{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media print{body{background:white;padding:0}.no-print{display:none!important}.panel,header{box-shadow:none;border:1px solid #ddd}.wrap{max-width:none}}
</style>
</head>
<body>
<div class="wrap">
<header>
  <div class="brand">
    <img src="/assets/sasikumar-ai-logo.png" alt="SASIKUMAR AI Logo">
    <div><h1>SASIKUMAR AI</h1><div>Live Gold &amp; Silver Rates</div></div>
  </div>
  <div class="sub">📍 Thanjavur, Tamil Nadu, India</div>
  <div class="meta">📅 <span id="date"></span><br>🕒 <span id="time"></span></div>
</header>

<section class="panel">
  <div class="rates">
    <div class="rate"><h2>🟡 24K Gold</h2><div class="price" id="g24">Loading…</div><div class="unit">Per gram</div></div>
    <div class="rate"><h2>🟨 22K Gold</h2><div class="price" id="g22">Loading…</div><div class="unit">Per gram</div></div>
    <div class="rate silver" style="grid-column:1/-1"><h2>⚪ Silver 999</h2><div class="price" id="silver">Loading…</div><div class="unit">Per gram</div></div>
  </div>
  <div class="meta" id="updated">Fetching current rates…</div>
  <div id="status" role="status" aria-live="polite"></div>
</section>

<section class="panel" id="previewPanel">
  <h2 style="margin-top:0">👁️ Gold &amp; Silver Poster Preview</h2>
  <canvas id="poster" width="900" height="1120" aria-label="Gold and silver rate poster preview"></canvas>
  <p class="sub">SASIKUMAR AI · Thanjavur</p>
</section>


<section class="panel no-print" id="skGoldSilverControls">
  <h2 style="margin-top:0">📊 Gold &amp; Silver Data Controls</h2>
  <div class="actions">
    <button class="preview" onclick="skOpenAllData()">📂 Open All Data</button>
    <button class="close" onclick="skCloseAllData()">✖ Close All</button>
    <button class="save" onclick="skClearDisplay()">🧹 Clear Display</button>
  </div>
</section>

<section class="panel no-print">
  <div class="actions">
    <button class="preview" onclick="refreshRates()">🔄 Refresh Rates</button>
    <button class="share" onclick="sharePoster()">📤 Share</button>
    <button class="print" onclick="window.print()">🖨️ Print</button>
    <button class="save" onclick="savePoster()">💾 Save Image</button>
    <button class="close" onclick="closePreview()">✖ Close Preview</button>
    <a class="link home" href="/">🏠 Main Page</a>
  </div>
</section>
<footer>Live data is shown only when the rate API returns valid values.</footer>
</div>
<script>
const $ = id => document.getElementById(id);
let latest = {g24:0,g22:0,silver:0};
let refreshedAt = "";
const money = n => Number(n).toLocaleString("en-IN",{maximumFractionDigits:2});
function clock(){
  const now=new Date();
  $("date").textContent=now.toLocaleDateString("en-IN",{day:"2-digit",month:"long",year:"numeric"});
  $("time").textContent=now.toLocaleTimeString("en-IN");
}
clock();setInterval(clock,1000);

async function readJSON(url){
  const r=await fetch(url,{cache:"no-store",headers:{Accept:"application/json"}});
  const d=await r.json();
  if(!r.ok||d.ok===false)throw new Error("Rate API unavailable");
  return d;
}
async function refreshRates(){
  $("status").textContent="⏳ Fetching live Gold and Silver rates…";
  try{
    const qs="?state="+encodeURIComponent("Tamil Nadu")+"&district="+encodeURIComponent("Thanjavur");
    const [g,s]=await Promise.all([readJSON("/api/gold-rate"+qs),readJSON("/api/silver-rate"+qs)]);
    const g24=Number(g.rates?.["24K"]??g.gold24k??0);
    const g22=Number(g.rates?.["22K"]??g.gold22k??0);
    const sv=Number(s.price_gram_999??s.price_gram??0);
    if(!(g24>0&&g22>0&&sv>0))throw new Error("API did not return all expected rate values");
    latest={g24,g22,silver:sv};
    refreshedAt=new Date().toLocaleString("en-IN");
    $("g24").textContent="₹"+money(g24);
    $("g22").textContent="₹"+money(g22);
    $("silver").textContent="₹"+money(sv);
    $("updated").textContent="Updated: "+refreshedAt+" · Thanjavur, Tamil Nadu";
    $("status").textContent="✅ Live rates loaded.";
    drawPoster();
  }catch(e){
    console.error(e);
    $("status").textContent="⚠️ Live rates could not be loaded. Please refresh and try again.";
    drawPoster();
  }
}
function drawPoster(){
  const c=$("poster"),ctx=c.getContext("2d");
  ctx.fillStyle="#fffdf5";ctx.fillRect(0,0,c.width,c.height);
  ctx.fillStyle="#172033";ctx.fillRect(0,0,c.width,250);
  ctx.textAlign="center";
  const logo=new Image();
  logo.onload=()=>{ctx.drawImage(logo,390,25,120,120);posterText()};
  logo.onerror=posterText;
  function posterText(){
    ctx.fillStyle="#f6d36f";ctx.font="bold 36px Arial";ctx.fillText("SASIKUMAR AI",450,190);
    ctx.fillStyle="#ffffff";ctx.font="bold 30px Arial";ctx.fillText("LIVE GOLD & SILVER",450,230);
    ctx.fillStyle="#334155";ctx.font="26px Arial";ctx.fillText("THANJAVUR · TAMIL NADU",450,310);
    const rows=[
      ["24K GOLD",latest.g24,"#fff0bd"],
      ["22K GOLD",latest.g22,"#ffe2a0"],
      ["SILVER 999",latest.silver,"#e2e8f0"]
    ];
    let y=365;
    for(const [name,val,bg] of rows){
      ctx.fillStyle=bg;ctx.fillRect(65,y,770,170);
      ctx.fillStyle="#172033";ctx.font="bold 32px Arial";ctx.fillText(name,450,y+55);
      ctx.font="bold 43px Arial";ctx.fillText(val>0?"₹"+money(val)+" / gram":"Rate unavailable",450,y+112);
      y+=195;
    }
    ctx.fillStyle="#475569";ctx.font="23px Arial";ctx.fillText("Date: "+new Date().toLocaleDateString("en-IN"),450,1000);
    ctx.fillText("Updated: "+(refreshedAt||"Waiting for live data"),450,1040);
    ctx.font="20px Arial";ctx.fillText("Verify current rates before making a transaction.",450,1080);
  }
  logo.src="/assets/sasikumar-ai-logo.png";
}
function savePoster(){
  if(!(latest.g24>0&&latest.g22>0&&latest.silver>0)){
    $("status").textContent="⚠️ Load valid live rates before saving.";
    return;
  }
  const a=document.createElement("a");
  a.download="SASIKUMAR-AI-Thanjavur-Gold-Silver.png";
  a.href=$("poster").toDataURL("image/png");a.click();
}
async function sharePoster(){
  if(!(latest.g24>0&&latest.g22>0&&latest.silver>0)){
    $("status").textContent="⚠️ Load valid live rates before sharing.";
    return;
  }
  const text="SASIKUMAR AI · Thanjavur Gold & Silver Rates · 24K ₹"+money(latest.g24)+"/g · 22K ₹"+money(latest.g22)+"/g · Silver ₹"+money(latest.silver)+"/g · "+refreshedAt;
  try{
    if(navigator.share)await navigator.share({title:"SASIKUMAR AI Gold & Silver",text,url:location.href});
    else if(navigator.clipboard){await navigator.clipboard.writeText(text);$("status").textContent="✅ Rate details copied. You can paste and share them."}
    else $("status").textContent=text;
  }catch(e){if(e.name!=="AbortError")$("status").textContent="Share was not completed."}
}

function skOpenAllData(){
  $("previewPanel").hidden = false;
  $("g24").closest(".rate").hidden = false;
  $("g22").closest(".rate").hidden = false;
  $("silver").closest(".rate").hidden = false;
  $("status").textContent = "📂 All Gold & Silver data opened.";
  refreshRates();
}
function skCloseAllData(){
  $("previewPanel").hidden = true;
  $("g24").closest(".rate").hidden = true;
  $("g22").closest(".rate").hidden = true;
  $("silver").closest(".rate").hidden = true;
  $("status").textContent = "All rate details and preview closed. Use Open All Data to reopen.";
}
function skClearDisplay(){
  if(!confirm("Clear the displayed Gold/Silver rates and poster? Saved files and server data will not be deleted.")) return;
  latest = {g24:0,g22:0,silver:0};
  refreshedAt = "";
  $("g24").textContent = "—";
  $("g22").textContent = "—";
  $("silver").textContent = "—";
  $("updated").textContent = "Display cleared. Tap Refresh Rates to reload.";
  $("status").textContent = "🧹 Display cleared. Saved files and server data were not deleted.";
  drawPoster();
}

function closePreview(){
  $("previewPanel").hidden=true;
  $("status").textContent="Preview closed. Use Preview to show it again.";
  let b=document.getElementById("reopenPreview");
  if(!b){
    b=document.createElement("button");b.id="reopenPreview";b.className="preview no-print";
    b.textContent="👁️ Preview";b.style.cssText="width:100%;margin-bottom:12px";
    b.onclick=()=>{$("previewPanel").hidden=false;b.remove()};
    document.querySelector(".wrap").insertBefore(b,document.querySelector("footer"));
  }
}
refreshRates();
setInterval(refreshRates,5*60*1000);
</script>
</body>
</html>
