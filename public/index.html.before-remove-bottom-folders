    html +=
      '<h3 style="margin:18px 0 8px;">🔴 EXPIRED JOBS</h3>';

    html += expired.map(job=>
      '<div style="margin:10px 0;padding:14px;border-radius:12px;background:#2b1818;">' +
      '🔴 <b>'+esc(job.title)+'</b><br>' +
