    const list=JSON.parse(raw);

    const clean=Array.isArray(list)
      ? list.filter(j =>
          j &&
          typeof j === 'object' &&
          String(j.company || '').trim() &&
          String(j.title || '').trim() &&
          String(j.location || '').trim()
        )
