function startVoice(){

 const SR=window.SpeechRecognition||
          window.webkitSpeechRecognition;

 if(!SR){
   alert("🎤 இந்த browser-ல் voice recognition இல்லை.");
   return;
 }

 if(recognition){
   try{recognition.stop()}catch(e){}
 }

