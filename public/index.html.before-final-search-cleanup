<script id="sasikumar-first-page-search-live-fix">
(function () {
  function initSasikumarSearch() {
    var box = document.getElementById("sasikumarFirstPageSearch");
    var input = document.getElementById("sasikumarFirstPageSearchInput");
    if (!box || !input) return;

    var button = box.querySelector("button");
    if (!button) return;

    var output = document.getElementById("sasikumarFirstPageSearchResults");
    if (!output) {
      output = document.createElement("div");
      output.id = "sasikumarFirstPageSearchResults";
      output.style.cssText =
        "display:none;margin-top:12px;padding:14px;border-radius:12px;" +
        "background:#fff;color:#111827;white-space:pre-wrap;overflow-wrap:anywhere;";
      box.appendChild(output);
    }

    if (box.dataset.mobileSearchReady === "1") return;
    box.dataset.mobileSearchReady = "1";

    async function runSearch() {
      var query = input.value.trim();

      if (!query) {
        output.style.display = "block";
        output.textContent = "தேட வேண்டிய வார்த்தையை உள்ளிடுங்கள்.";
        input.focus();
        return;
      }

      output.style.display = "block";
      output.textContent = "🔎 தேடுகிறது... / Searching...";
      button.disabled = true;

      try {
        var response = await fetch(
          "/api/global-search?q=" + encodeURIComponent(query),
          { headers: { "Accept": "application/json" } }
        );
        var data = await response.json();

        if (!response.ok || !data.success) {
          throw new Error(data.error || "Search failed (" + response.status + ")");
        }

        output.replaceChildren();

        var answer = document.createElement("p");
        answer.style.cssText = "margin:0 0 12px;white-space:pre-wrap;overflow-wrap:anywhere;";
        answer.textContent = data.answer || "தேடல் முடிவு கிடைக்கவில்லை.";
        output.appendChild(answer);

        (Array.isArray(data.results) ? data.results : []).forEach(function (item) {
          if (!item || (!item.title && !item.url && !item.content)) return;

          var row = document.createElement("div");
          row.style.cssText = "margin-top:10px;padding-top:8px;border-top:1px solid #ddd;overflow-wrap:anywhere;";

          if (item.url) {
            try {
              var url = new URL(item.url, window.location.origin);
              if (url.protocol === "https:" || url.protocol === "http:") {
                var link = document.createElement("a");
                link.href = url.href;
                link.target = "_blank";
                link.rel = "noopener noreferrer";
                link.textContent = item.title || item.url;
                row.appendChild(link);
              }
            } catch (_) {}
          } else if (item.title) {
            var title = document.createElement("strong");
            title.textContent = item.title;
            row.appendChild(title);
          }

          if (item.content) {
            var detail = document.createElement("div");
            detail.style.cssText = "margin-top:4px;font-size:14px;overflow-wrap:anywhere;";
            detail.textContent = item.content;
            row.appendChild(detail);
          }

          output.appendChild(row);
        });
      } catch (error) {
        output.textContent =
          "தேடலில் பிழை ஏற்பட்டது. மீண்டும் முயற்சிக்கவும்.\n" +
          (error.message || "Unknown error");
      } finally {
        button.disabled = false;
      }
    }

    window.sasikumarFirstPageRunSearch = runSearch;
    button.onclick = runSearch;

    input.addEventListener("keydown", function (event) {
      if (event.key === "Enter") {
        event.preventDefault();
        runSearch();
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSasikumarSearch);
  } else {
    initSasikumarSearch();
  }
})();
</script>



