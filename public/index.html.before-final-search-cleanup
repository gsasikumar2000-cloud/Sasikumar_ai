    ' &nbsp; 🔴 EXPIRED: '+list.filter(j=>j.status==='EXPIRED').length+
    ' &nbsp; 📋 TOTAL: '+countAll+
    '</div>';

  if(live.length){

    html +=
      '<h3 style="margin:14px 0 8px;">🟢 LIVE JOB CONTENT</h3>';

    html += live.map(job=>{

      const wa=normalizeWhatsApp(job.whatsapp);

