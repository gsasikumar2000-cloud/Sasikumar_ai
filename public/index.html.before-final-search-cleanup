        (job.description
          ? '<div style="margin-top:10px;padding:10px;border-radius:10px;background:#303030;">' +
            '<b>📝 JOB DETAILS</b><br>'+esc(job.description)+
            '</div>'
          : '') +

        (job.requirements
          ? '<div style="margin-top:10px;padding:10px;border-radius:10px;background:#303030;">' +
            '<b>📋 REQUIREMENTS</b><br>'+esc(job.requirements)+
            '</div>'
          : '') +

        (job.message
          ? '<div style="margin-top:10px;padding:10px;border-radius:10px;background:#303030;">' +
            '<b>📰 MESSAGE</b><br>'+esc(job.message)+
            '</div>'
          : '') +

