<script id="sasikumarFirstPageSearchFix">
(function () {
  function setupFirstPageSearch() {
    const input = document.getElementById("sasikumarFirstPageSearchInput");
    const box = document.getElementById("sasikumarFirstPageSearch");
    if (!input || !box || input.dataset.searchFixReady === "1") return;

    input.dataset.searchFixReady = "1";

    let output = document.getElementById("sasikumarFirstPageSearchResults");
    if (!output) {
      output = document.createElement("div");
      output.id = "sasikumarFirstPageSearchResults";
      output.style.cssText =
        "display:none;margin-top:12px;padding:14px;border-radius:12px;" +
        "background:#fff;color:#111827;white-space:pre-wrap;overflow-wrap:anywhere;";
      box.appendChild(output);
    }

    async function runSearch() {
      const query = input.value.trim();
      if (!query) {
        output.style.display = "block";
        output.textContent = "தயவுசெய்து தேட வேண்டிய வார்த்தையை உள்ளிடுங்கள்.";
        input.focus();
        return;
      }

      output.style.display = "block";
      output.textContent = "🔎 தேடுகிறது... / Searching...";

      try {
        const response = await fetch(
          "/api/global-search?q=" + encodeURIComponent(query)
        );
        const data = await response.json();

        if (!response.ok || !data.success) {
          throw new Error(data.error || "Search failed");
        }

        output.replaceChildren();

        const answer = document.createElement("p");
        answer.style.cssText = "margin:0 0 12px;white-space:pre-wrap;";
        answer.textContent = data.answer || "தேடல் முடிவு கிடைக்கவில்லை.";
        output.appendChild(answer);

        (Array.isArray(data.results) ? data.results : []).forEach(function (item) {
          if (!item.title && !item.url) return;
          const row = document.createElement("div");
          row.style.cssText = "margin-top:10px;padding-top:8px;border-top:1px solid #ddd;";

          if (item.url) {
            try {
              const url = new URL(item.url);
              if (url.protocol === "https:" || url.protocol === "http:") {
                const link = document.createElement("a");
                link.href = url.href;
                link.target = "_blank";
                link.rel = "noopener noreferrer";
                link.textContent = item.title || item.url;
                row.appendChild(link);
              }
            } catch (_) {}
          } else {
            row.textContent = item.title || "";
          }

          if (item.content) {
            const detail = document.createElement("div");
            detail.style.cssText = "margin-top:4px;font-size:14px;";
            detail.textContent = item.content;
            row.appendChild(detail);
          }
          output.appendChild(row);
        });
      } catch (error) {
        output.textContent =
          "தேடலில் பிழை ஏற்பட்டது. மீண்டும் முயற்சிக்கவும்.\n" +
          (error.message || "");
      }
    }

    const button = box.querySelector("button");
    if (button) button.onclick = runSearch;

    input.addEventListener("keydown", function (event) {
      if (event.key === "Enter") {
        event.preventDefault();
        runSearch();
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupFirstPageSearch);
  } else {
    setupFirstPageSearch();
  }
})();
</script>



