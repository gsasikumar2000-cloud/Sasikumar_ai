(function(){
  function move(id, beforeId){
    const a=document.getElementById(id);
    const b=document.getElementById(beforeId);
    if(a && b && a!==b && b.parentNode){
      b.parentNode.insertBefore(a,b);
    }
  }

  function hideEducationDetails(){
    document.querySelectorAll('h1,h2,h3').forEach(function(h){
      const t=(h.textContent||'').trim().toUpperCase();
      if(t.includes('EDUCATION DETAILS')){
        let x=h;
        for(let i=0;i<5 && x;i++,x=x.parentElement){
          if(x.tagName==='SECTION' || x.id || x.classList.contains('service-card')){
            x.style.display='none';
            break;
          }
        }
      }
    });
  }

  function applyOrder(){
    const search=document.getElementById('sasikumar-ai-search-box');

    /* FINAL FIRST-PAGE ORDER */
    const nameBoard=document.getElementById('sasikumarFinalNameBoard');
    const firstSearch=document.getElementById('sasikumarFirstPageSearch');
    const webSearch=document.getElementById('skFirstPageWebSearch');
    const creator=document.getElementById('aiArtistMaker');
    const tools=document.getElementById('skFirstPageTools');

    if(nameBoard && nameBoard.parentNode){
      let parent=nameBoard.parentNode;

      /* Keep Web Search directly after the name board */
      if(webSearch && webSearch.parentNode === parent){
        parent.insertBefore(webSearch,nameBoard.nextSibling);
      }

      /* Keep AI Creator after Web Search */
      if(creator && creator.parentNode === parent){
        parent.insertBefore(
          creator,
          webSearch && webSearch.parentNode === parent
            ? webSearch.nextSibling
            : nameBoard.nextSibling
        );
      }

      /* Keep Tools after AI Creator */
      if(tools && tools.parentNode === parent){
        parent.insertBefore(
          tools,
          creator && creator.parentNode === parent
            ? creator.nextSibling
            : nameBoard.nextSibling
        );
      }
    }

    if(!search) return;

    /* Top order */

    /* Keep first-page login after Tool Kit */
    const login=document.getElementById('sasikumarLoginScreen');
    if(login && tools && tools.parentNode){
      tools.parentNode.insertBefore(login,tools.nextSibling);
    }

    /* First-page Tools remain available after the main top content */
    if(tools) tools.style.display='block';

    /* Move live market cards after the login area */
    const live=document.getElementById('skAllContentLiveCard');
    if(live && login && login.parentNode){
      login.parentNode.insertBefore(live,login.nextSibling);
    }

    /* Keep Gold/Education/Jobs/etc. after live content */
    const gold=document.getElementById('newGoldServices');
    const liveCard=document.getElementById('skAllContentLiveCard');
    if(gold && liveCard && liveCard.parentNode){
      liveCard.parentNode.insertBefore(gold,liveCard.nextSibling);
    }

    /* Business merge: place Pay2All and UPI immediately after Banking Products */
    const bank=document.getElementById('banking-products');
    const wallet=document.getElementById('sasikumarPay2AllWallet');
    const upi=document.getElementById('upi-bottom-dashboard');
    if(bank && bank.parentNode){
      if(wallet) bank.parentNode.insertBefore(wallet,bank.nextSibling);
      if(upi){
        const ref=wallet && wallet.parentNode ? wallet : bank;
        ref.parentNode.insertBefore(upi,ref.nextSibling);
      }
    }

    hideEducationDetails();
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',applyOrder);
  }else{
    applyOrder();
  }

  setTimeout(applyOrder,500);
  setTimeout(applyOrder,1500);

  /* FINAL TOP VISIBILITY + ORDER */
  function sasikumarFinalTopOrder(){
    const anchor = document.getElementById('sasikumarFinalNameBoard');
    const mainReply = document.getElementById('sasikumarMainReply');
    const chatBox = document.getElementById('chat');
    const reply = document.getElementById('sasikumarReplyTop');
    const askReply = document.getElementById('sasikumarAskReplyTop');
    const web = document.getElementById('skFirstPageWebSearch');
    const creator = document.getElementById('aiArtistMaker');
    const tools = document.getElementById('skFirstPageTools');
    const login = document.getElementById('sasikumarLoginScreen');

    if(!anchor || !anchor.parentNode) return;

    const parent = anchor.parentNode;

    /* Hide old presentation-only Reply cards */
    [reply, askReply].forEach(function(el){
      if(el){
        el.style.display = 'none';
        el.style.visibility = 'hidden';
        el.style.opacity = '0';
      }
    });

    /* Requested top order:
       Reply -> Web Search -> Design -> Tool Kit */
    let ref = anchor;

    [mainReply, chatBox, web, creator, tools].forEach(function(el){
      if(el){
        parent.insertBefore(el, ref.nextSibling);
        ref = el;
      }
    });

    /* Keep Login after the requested top sections */
    if(login && ref){
      parent.insertBefore(login, ref.nextSibling);
    }

    /* Keep old duplicate Reply cards hidden */
    if(reply){
      reply.style.display = 'none';
      reply.style.visibility = 'hidden';
      reply.style.opacity = '0';
    }

    if(askReply){
