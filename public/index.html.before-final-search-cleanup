<script>
(function(){

  let sasikumarCurrentZoom = 1;

  window.sasikumarZoom = function(step){
    if(step === 0){
      sasikumarCurrentZoom = 1;
    }else{
      sasikumarCurrentZoom += step;
    }

    sasikumarCurrentZoom =
      Math.max(0.70, Math.min(1.50, sasikumarCurrentZoom));

    document.documentElement.style.zoom =
      sasikumarCurrentZoom.toFixed(2);
  };

  /* 360 degree logo animation on click */
  document.addEventListener('click', function(e){
    const logo = e.target.closest(
      'header img, .sasikumar-header img, #sasikumarHeader img, #topHeader img'
    );

    if(!logo) return;

    logo.animate(
      [
        {transform:'rotate(0deg)'},
        {transform:'rotate(360deg)'}
      ],
      {
        duration:700,
        easing:'ease-in-out'
      }
    );
  });

})();
</script>





