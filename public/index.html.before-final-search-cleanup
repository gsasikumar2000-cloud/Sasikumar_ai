<script>
(function(){
  let zoomLevel = 1;
  const minZoom = 0.8;
  const maxZoom = 1.2;
  const step = 0.1;

  window.skApplyZoom = function(){
    document.documentElement.style.zoom = zoomLevel;
    const percent = document.getElementById("skZoomPercent");
    if (percent) percent.textContent = Math.round(zoomLevel * 100) + "%";
  };

  window.skZoomIn = function(){
    zoomLevel = Math.min(maxZoom, +(zoomLevel + step).toFixed(2));
    skApplyZoom();
  };

  window.skZoomOut = function(){
    zoomLevel = Math.max(minZoom, +(zoomLevel - step).toFixed(2));
    skApplyZoom();
  };

  window.skZoomReset = function(){
    zoomLevel = 1;
    skApplyZoom();
  };
})();
</script>

