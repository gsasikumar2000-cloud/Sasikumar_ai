<script id="sasikumar-unified-live-card-script">
(function(){
  function shareCurrent(title){
    const url=location.href;
    if(navigator.share){
      navigator.share({
        title:title || "SASIKUMAR AI",
        text:title || "SASIKUMAR AI",
        url:url
      }).catch(function(){});
    }else{
      navigator.clipboard?.writeText(url).then(function(){
        alert("📤 Link copied. You can share it now.");
      }).catch(function(){
        alert("📤 Share is not supported on this device.");
      });
    }
  }

  function whatsappShare(title){
    const url=location.href;
    const text=encodeURIComponent((title || "SASIKUMAR AI")+"\n"+url);
    window.open("https://wa.me/?text="+text,"_blank","noopener");
  }

  function facebookShare(){
    const url=encodeURIComponent(location.href);
    window.open(
      "https://www.facebook.com/sharer/sharer.php?u="+url,
      "_blank",
      "noopener"
    );
  }

  function addShareRow(card){
    if(!card || card.querySelector(".skLiveShareRow")) return;

    const title=(card.querySelector("h2,h3")?.textContent || "SASIKUMAR AI").trim();

    const row=document.createElement("div");
    row.className="skLiveShareRow";

    const share=document.createElement("button");
    share.type="button";
    share.textContent="📤 Share";
    share.onclick=function(e){
      e.stopPropagation();
      shareCurrent(title);
    };

    const wa=document.createElement("button");
    wa.type="button";
    wa.textContent="🟢 WhatsApp";
    wa.onclick=function(e){
      e.stopPropagation();
      whatsappShare(title);
    };

    const fb=document.createElement("button");
    fb.type="button";
    fb.textContent="🔵 Facebook";
    fb.onclick=function(e){
      e.stopPropagation();
      facebookShare();
    };

    row.append(share,wa,fb);
    card.appendChild(row);
  }

  function applyLiveModel(){
    document.querySelectorAll(
      "#skVideoAdCard,#skLiveImagesCard,.skMainLiveGrid .skMainFeatureCard"
    ).forEach(function(card){
      addShareRow(card);

      const media=card.querySelector("img,video");
      if(media){
        media.classList.add("skLiveCardMedia");
      }
    });

    /* 2-minute video limit */
    const video=document.getElementById("skVideoAd");
    if(video && !video.dataset.twoMinuteGuard){
      video.dataset.twoMinuteGuard="1";

      video.addEventListener("timeupdate",function(){
        if(video.currentTime >= 120){
          video.pause();
          video.currentTime=0;
        }
      });

      video.addEventListener("loadedmetadata",function(){
        if(isFinite(video.duration) && video.duration > 120){
          video.dataset.maxDuration="120";
        }
      });
    }
  }

  if(document.readyState==="loading"){
    document.addEventListener("DOMContentLoaded",applyLiveModel);
  }else{
    applyLiveModel();
  }

  setTimeout(applyLiveModel,500);
  setTimeout(applyLiveModel,1500);
  setTimeout(applyLiveModel,3000);
})();
</script>


