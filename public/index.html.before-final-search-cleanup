<script>
let sasikumarBreakingHomeLanguage = "ta";

async function loadSasikumarBreakingHomeNews() {
  const box = document.getElementById("sasikumarBreakingHomeText");
  const time = document.getElementById("sasikumarBreakingHomeTime");
  if (!box) return;

  box.textContent = "📰 செய்திகள் தேடப்படுகிறது...";
  try {
    const language = sasikumarBreakingHomeLanguage || "ta";
    const response = await fetch(
      "/api/breaking-news?category=" +
      encodeURIComponent("Tamil Nadu") +
      "&language=" + encodeURIComponent(language) +
      "&_=" + Date.now()
    );

    const data = await response.json();
    if (!response.ok || !data.ok) {
      throw new Error(data.reply || data.error || "News unavailable");
    }

    const titles = Array.isArray(data.news)
      ? data.news.map(item => String(item.title || item.content || "").trim()).filter(Boolean)
      : [];
    const answerLines = String(data.answer || data.reply || "")
      .split(/\r?\n/)
      .map(line => line.trim())
      .filter(Boolean);
    const lines = (titles.length ? titles : answerLines).slice(0, 10);

    box.replaceChildren();
    if (!lines.length) {
      box.textContent = "தற்போது செய்திகள் கிடைக்கவில்லை. மீண்டும் Refresh செய்யவும்.";
    } else {
      lines.forEach((line, index) => {
        const row = document.createElement("div");
        row.style.cssText = "padding:8px 0;border-bottom:1px solid #eee;";
        const number = document.createElement("b");
        number.style.color = "#c00";
        number.textContent = (index + 1) + ". ";
        row.appendChild(number);
        row.appendChild(document.createTextNode(line));
        box.appendChild(row);
      });
    }

    if (time) {
      time.textContent = "🕐 Last updated: " + new Date().toLocaleString("en-IN");
    }
  } catch (error) {
    console.error("Home Breaking News:", error);
    box.textContent = "❌ செய்திகள் தற்போது கிடைக்கவில்லை. Refresh செய்து மீண்டும் முயற்சிக்கவும்.";
    if (time) time.textContent = "சிறிது நேரம் கழித்து மீண்டும் முயற்சிக்கவும்.";
  }
}

function setSasikumarBreakingHomeLanguage(language) {
  sasikumarBreakingHomeLanguage = language || "ta";
  loadSasikumarBreakingHomeNews();
}

document.addEventListener("DOMContentLoaded", function () {
  loadSasikumarBreakingHomeNews();
});

</script>



