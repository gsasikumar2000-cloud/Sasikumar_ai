<script id="hub-pay2all-balance">
async function hubRefreshBalance(){
  const balance=document.getElementById("hubBalance");
  const status=document.getElementById("hubBalanceStatus");
  if(!balance||!status)return;

  balance.textContent="Checking...";
  status.textContent="Connecting to Pay2All...";

  try{
    const r=await fetch("/api/recharge/balance",{cache:"no-store"});
    const j=await r.json();

    if(j && j.status_id===1 && j.data){
      balance.textContent="₹"+Number(j.data.balance||0).toLocaleString("en-IN",{minimumFractionDigits:2});
      status.textContent="✅ Wallet Balance • "+(j.data.organization||"Pay2All")+" • "+(j.data.currency||"INR");
    }else{
      balance.textContent="Unavailable";
      status.textContent="❌ Balance unavailable";
    }
  }catch(e){
    balance.textContent="Unavailable";
    status.textContent="❌ Connection error";
  }
}

document.addEventListener("DOMContentLoaded",hubRefreshBalance);
</script>

