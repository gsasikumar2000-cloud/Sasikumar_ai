<script id="hub-location-script">
(function(){
 const el=document.getElementById("hub-location-text");
 if(!navigator.geolocation){el.textContent="Location not supported";return;}
 navigator.geolocation.getCurrentPosition(async function(pos){
   const lat=pos.coords.latitude, lon=pos.coords.longitude;
   try{
     const r=await fetch("https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat="+lat+"&lon="+lon);
     const d=await r.json(), a=d.address||{};
     el.textContent=[a.village||a.town||a.city,a.district,a.state,a.country].filter(Boolean).join(", ");
   }catch(e){el.textContent="GPS location detected";}
 },function(){el.textContent="Location permission required";});
})();
</script>
