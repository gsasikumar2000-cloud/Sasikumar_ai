result.innerHTML='<p>⏳ Saving video...</p>';

try{
var r=await fetch("/api/video/import",{
method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify({url:x})
});

var data=await r.json();

if(!r.ok || !data.ok){
