<!-- FINANCE -->
<div class="card">
<h2>💰 Finance Maths</h2>

<div class="grid">

<div>
<h3>📈 Simple Interest</h3>
<div class="eq">SI = (P × R × T) ÷ 100</div>
<div class="eq">Amount = P + SI</div>
</div>

<div>
<h3>📊 Compound Interest</h3>
<div class="eq">A = P(1 + R/100)ⁿ</div>
<div class="eq">CI = A − P</div>
</div>

