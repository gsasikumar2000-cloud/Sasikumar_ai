  font-size:16px;
  line-height:1.8;
}
</style>
</head>

<body>
<div class="container">

<div class="top">
<button onclick="location.href='/'">🏠 Dashboard</button>
<button onclick="window.print()">🖨️ Print / PDF</button>
</div>

<h1>📐 SASIKUMAR AI — Equations</h1>
<div class="subtitle">
🧮 Maths • 🪙 Gold • 💰 Finance • 📊 Business Maths
</div>


<!-- CLASS 1-12 MATHEMATICS LEARNING FLOW -->
<div class="card maths-learning-card">
<h2>📚 School Mathematics — Class 1 to 12</h2>

<p class="note">
Class → Mathematics Topic → Open Selected → Tamil + English maximum useful details
</p>

<div class="grid">

<div>
<label><b>1️⃣ Select Class</b></label>
<select id="mathClass" style="width:100%;padding:11px;border:1px solid #ccc;border-radius:8px;margin:5px 0 12px;">
<option value="">Select Class</option>
<option>Class 1</option>
<option>Class 2</option>
<option>Class 3</option>
<option>Class 4</option>
<option>Class 5</option>
<option>Class 6</option>
<option>Class 7</option>
<option>Class 8</option>
<option>Class 9</option>
<option>Class 10</option>
<option>Class 11</option>
<option>Class 12</option>
</select>
</div>

<div>
<label><b>2️⃣ Subject</b></label>
<select id="mathSubject" style="width:100%;padding:11px;border:1px solid #ccc;border-radius:8px;margin:5px 0 12px;">
<option value="Mathematics">Mathematics</option>
</select>
</div>

<div>
<label><b>3️⃣ Select Chapter / Topic</b></label>
<select id="mathTopic" style="width:100%;padding:11px;border:1px solid #ccc;border-radius:8px;margin:5px 0 12px;">
<option value="">Select Class first</option>
</select>
</div>

</div>

<button id="mathOpenBtn" disabled onclick="openMathTopic()">
📖 Open Selected
</button>

<div id="mathSelectedInfo" class="note" style="margin-top:10px;">
Select Class → Mathematics → Chapter / Topic
</div>

<div id="mathDetails" class="math-details" style="display:none;"></div>

<button id="mathGoogleBtn" style="display:none;" onclick="searchMathTopic()">
🔎 Google Search – More Details
</button>

</div>

<script>
(function(){

const classEl = document.getElementById("mathClass");
const topicEl = document.getElementById("mathTopic");
const openBtn = document.getElementById("mathOpenBtn");
const infoEl = document.getElementById("mathSelectedInfo");
const detailsEl = document.getElementById("mathDetails");
const googleBtn = document.getElementById("mathGoogleBtn");

const topics = {
"Class 1":[
"Numbers","Counting","Addition","Subtraction","Shapes","Measurement","Time","Money"
],
"Class 2":[
"Numbers","Addition","Subtraction","Multiplication","Division","Fractions","Shapes","Measurement","Time","Money"
],
"Class 3":[
"Numbers","Addition","Subtraction","Multiplication","Division","Fractions","Decimals","Measurement","Time","Money","Geometry"
],
"Class 4":[
"Large Numbers","Addition","Subtraction","Multiplication","Division","Fractions","Decimals","Factors","Multiples","Geometry","Measurement","Data Handling"
],
"Class 5":[
"Numbers","Factors and Multiples","Fractions","Decimals","Percentage","Geometry","Area and Perimeter","Measurement","Data Handling"
],
"Class 6":[
"Knowing Our Numbers","Whole Numbers","Integers","Fractions","Decimals","Ratio","Percentage","Algebra","Basic Geometry","Mensuration","Data Handling"
],
"Class 7":[
"Integers","Fractions and Decimals","Data Handling","Simple Equations","Lines and Angles","Triangles","Comparing Quantities","Perimeter and Area","Algebraic Expressions","Exponents","Symmetry","Probability"
],
"Class 8":[
"Rational Numbers","Linear Equations","Understanding Quadrilaterals","Practical Geometry","Data Handling","Squares and Square Roots","Cubes and Cube Roots","Comparing Quantities","Algebraic Expressions","Mensuration","Exponents and Powers","Direct and Inverse Proportion","Factorisation","Introduction to Graphs","Probability"
],
"Class 9":[
"Number Systems","Polynomials","Coordinate Geometry","Linear Equations in Two Variables","Euclid Geometry","Lines and Angles","Triangles","Quadrilaterals","Circles","Heron's Formula","Surface Areas and Volumes","Statistics","Probability"
],
"Class 10":[
"Real Numbers","Polynomials","Pair of Linear Equations","Quadratic Equations","Arithmetic Progressions","Triangles","Coordinate Geometry","Introduction to Trigonometry","Applications of Trigonometry","Circles","Areas Related to Circles","Surface Areas and Volumes","Statistics","Probability"
],
"Class 11":[
"Sets","Relations and Functions","Trigonometric Functions","Principle of Mathematical Induction","Complex Numbers","Linear Inequalities","Permutations and Combinations","Binomial Theorem","Sequences and Series","Straight Lines","Conic Sections","Introduction to Three Dimensional Geometry","Limits and Derivatives","Statistics","Probability"
],
"Class 12":[
"Relations and Functions","Inverse Trigonometric Functions","Matrices","Determinants","Continuity and Differentiability","Applications of Derivatives","Integrals","Applications of Integrals","Differential Equations","Vector Algebra","Three Dimensional Geometry","Linear Programming","Probability"
]
};

classEl.addEventListener("change", function(){
  topicEl.innerHTML = '<option value="">Select Chapter / Topic</option>';

  (topics[this.value] || []).forEach(function(topic){
    const option = document.createElement("option");
    option.value = topic;
    option.textContent = topic;
    topicEl.appendChild(option);
  });

  openBtn.disabled = true;
  detailsEl.style.display = "none";
  googleBtn.style.display = "none";
  infoEl.textContent = this.value
    ? this.value + " → Mathematics → Select Chapter / Topic"
    : "Select Class → Mathematics → Chapter / Topic";
});

topicEl.addEventListener("change", function(){
  const cls = classEl.value;
  const topic = this.value;

  openBtn.disabled = !(cls && topic);

  if(cls && topic){
    infoEl.textContent = "Selected: " + cls + " → Mathematics → " + topic;
  }
});

window.openMathTopic = async function(){

  const cls = classEl.value;
  const topic = topicEl.value;

  if(!cls || !topic) return;

  detailsEl.style.display = "block";
  detailsEl.innerHTML =
    "<h3>⏳ Preparing Mathematics Full Details...</h3>" +
    "<p>📚 Tamil + English explanation, formulas, examples, step-by-step solution, practice and revision.</p>";

  googleBtn.style.display = "inline-block";

  const prompt =
`You are SASIKUMAR AI School Mathematics Tutor.

Teach ${cls} Mathematics topic: ${topic}.

Give maximum useful educational details. Do NOT limit the answer to a fixed number of lines.

Use simple class-level language.

Include BOTH Tamil and English.

Required sections:

1. Topic Title
2. Tamil Explanation
3. English Explanation
4. Important Points
5. Definitions
6. Formulae
7. Rules
8. Symbols and meanings
9. Step-by-step Explanation
10. Solved Examples
11. More Examples
12. Easy Method
13. Common Mistakes
14. Practice Questions
15. Answers
16. Quick Revision
17. Summary
18. Exam / Learning Tips

For every numerical example, show the calculation clearly step by step.

Keep the mathematics accurate and suitable for ${cls}.`;

  try {

    const response = await fetch("/api/intelligent-ai",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({
        message:prompt,
        source:"education-mathematics"
      })
    });

    const data = await response.json();

    const reply =
      data.reply ||
      data.response ||
      data.message ||
      data.answer ||
      "";

    if(!reply){
      throw new Error("No AI reply received");
    }

    detailsEl.innerHTML =
      "<h3>📖 " + escapeMathHTML(cls + " Mathematics — " + topic) + "</h3>" +
      "<div class='math-ai-content'>" +
      escapeMathHTML(reply) +
      "</div>";

  } catch(error){

    detailsEl.innerHTML =
      "<h3>📖 " + escapeMathHTML(cls + " Mathematics — " + topic) + "</h3>" +
      "<p>AI details could not be loaded right now.</p>" +
      "<p>Please try Open Selected again or use Google Search – More Details.</p>";
  }
};

window.searchMathTopic = function(){

  const cls = classEl.value;
  const topic = topicEl.value;

  if(!cls || !topic) return;

  const query =
    cls + " Mathematics " + topic +
    " formulas examples solved problems notes";

  window.open(
    "https://www.google.com/search?q=" +
    encodeURIComponent(query),
    "_blank"
  );
};

function escapeMathHTML(value){
  return String(value)
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;")
    .replace(/\n/g,"<br>");
}

})();
</script>

<!-- MATHS -->
