  const s=document.getElementById("subjectFilter").value;
  const g=document.getElementById("groupFilter").value;
  const q=document.getElementById("search").value.toLowerCase();

  const groupSubjects=GROUPS[g]||[];

  const data=QA.filter(x=>{
    const isTamil=/[\u0B80-\u0BFF]/.test(x.q+" "+x.a);
    const medium=isTamil ? "Tamil" : "English";

    return (!c||x.c===c)
      &&(!m||medium===m)
