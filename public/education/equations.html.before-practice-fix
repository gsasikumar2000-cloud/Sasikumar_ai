          .replace(/\n/g, "<br>");

      } finally {
        clearTimeout(timeout);
      }

    } catch (error) {
      console.error(
        "Government Q&A explanation error:",
        error
      );

      explanationBox.innerHTML =
        "⚠️ AI explanation is temporarily unavailable. " +
        "The Answer above remains available.";
    }
  }
