let governmentQAPage = 0;
const GOVERNMENT_QA_PAGE_SIZE = 1;

function resetGovernmentQAPage() {
  governmentQAPage = 0;
}

const qaAutoLoadInstalled = true;

function installQAAutoLoad() {
  ["qaClass","qaSubject","qaMedium","qaMark","qaImportant"].forEach(id => {
    const el = document.getElementById(id);
    if (!el || el.dataset.qaAutoLoad === "1") return;

    el.dataset.qaAutoLoad = "1";
    el.addEventListener("change", () => {
      resetGovernmentQAPage();
      loadGovernmentQABank();
    });
  });
}


if (document.readyState === "loading") {
  document.addEventListener("DOMContentLoaded", installQAAutoLoad);
} else {
  installQAAutoLoad();
}

function renderGovernmentQAPagination(total) {
  const box = document.getElementById("qaPagination");
  if (!box) return;

  const totalPages = Math.max(1, Math.ceil(total / GOVERNMENT_QA_PAGE_SIZE));

  governmentQAPage = Math.max(
    0,
    Math.min(governmentQAPage, totalPages - 1)
  );

  box.innerHTML = `
    <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin:14px 0;padding:10px;border-radius:12px;background:#f3f4f6;">
      <button
        type="button"
        onclick="changeGovernmentQAPage(-1)"
        ${governmentQAPage <= 0 ? "disabled" : ""}
        style="padding:10px 14px;border-radius:10px;font-weight:bold;">
        ◀ Previous
      </button>

      <strong>
        Question ${governmentQAPage + 1} / ${totalPages}
      </strong>

      <button
        type="button"
        onclick="changeGovernmentQAPage(1)"
        ${governmentQAPage >= totalPages - 1 ? "disabled" : ""}
        style="padding:10px 14px;border-radius:10px;font-weight:bold;">
        Next ▶
      </button>
    </div>
  `;
}

function changeGovernmentQAPage(direction) {
  const step = Number(direction) || 0;
  const total = Number(window.__governmentQATotal || 0);
  console.log("📄 NEXT DEBUG:", {
    direction: step,
    currentPage: governmentQAPage,
    totalQuestions: total,
    pageSize: GOVERNMENT_QA_PAGE_SIZE
  });

  console.log("📄 QA PAGE CLICK:", {
    direction: step,
    currentPage: governmentQAPage,
    total
  });

  if (!total) return;

  const totalPages = Math.max(
    1,
    Math.ceil(total / GOVERNMENT_QA_PAGE_SIZE)
  );

  const nextPage = governmentQAPage + step;

  if (nextPage < 0 || nextPage >= totalPages) return;

  governmentQAPage = nextPage;
  loadGovernmentQABank();
}

