function getQABankText() {
  return document.getElementById("qaResultBox")?.innerText || "";
}

function selectQABank() {
  const box = document.getElementById("qaResultBox");
  if (!box) return;
  const range = document.createRange();
  range.selectNodeContents(box);
  const sel = window.getSelection();
  sel.removeAllRanges();
  sel.addRange(range);
}

async function copyQABank() {
  const text = getQABankText();
  if (!text) return;
  await navigator.clipboard.writeText(text);
  alert("✅ Q&A copied");
}

function cutQABank() {
  selectQABank();
  document.execCommand("cut");
}

async function pasteQABank() {
  const text = await navigator.clipboard.readText();
  document.getElementById("qaResultBox").focus();
  document.execCommand("insertText", false, text);
}

async function shareQABank() {
  const text = getQABankText();
  if (navigator.share) {
    await navigator.share({
      title: "SASIKUMAR AI Q&A Bank",
      text
    });
  } else {
    await navigator.clipboard.writeText(text);
    alert("✅ Q&A copied for sharing");
  }
}


