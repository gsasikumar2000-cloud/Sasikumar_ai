console.log("📚 QA DEBUG subjects:", [...new Set(GOVERNMENT_QA_BANK.map(x => x.subject))]);
console.log("📚 QA DEBUG mediums:", [...new Set(GOVERNMENT_QA_BANK.map(x => x.medium))]);
console.log("📚 QA DEBUG marks:", [...new Set(GOVERNMENT_QA_BANK.map(x => String(x.mark)))]);


