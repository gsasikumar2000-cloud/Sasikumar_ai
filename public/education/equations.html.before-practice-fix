    box.innerHTML += `
      <hr>
      <h3>🔄 Follow Up</h3>
      <p><strong>Question:</strong> ${followUp.trim()}</p>
      <p>🤖 SASIKUMAR AI — Follow-up question received.</p>
    `;
  }
}

function updateQABankUrl() {
  const el = document.getElementById("qaResultUrl");
  if (el) el.textContent = window.location.href;
}

function moveQABank(direction) {
  const box = document.getElementById("qaResultBox");
  if (!box) return;
  window.scrollBy({
    top: direction * 500,
    behavior: "smooth"
  });
}

function printQABank() {
  const box = document.getElementById("qaResultBox");
  if (!box) return;

  const w = window.open("", "_blank");
  w.document.write(`
    <html>
    <head>
      <title>SASIKUMAR AI — Q&A Bank</title>
      <style>
        @page { size: Legal; margin: 18mm; }
        body { font-family: Arial, sans-serif; line-height:1.6; }
      </style>
    </head>
    <body>${box.innerHTML}</body>
    </html>
  `);
  w.document.close();
  w.print();
}

function saveQABank() {
  const blob = new Blob([getQABankText()], {
    type: "text/plain;charset=utf-8"
  });

  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "sasikumar-ai-qa-bank.txt";
  a.click();
  URL.revokeObjectURL(a.href);
}

function popQABank() {
  const box = document.getElementById("qaResultBox");
  if (!box) return;

  const w = window.open("", "SASIKUMAR_AI_QA",
    "width=900,height=700,scrollbars=yes");

  w.document.write(`
    <html>
    <head>
      <title>SASIKUMAR AI Q&A Bank</title>
    </head>
    <body>${box.innerHTML}</body>
    </html>
  `);

  w.document.close();
}
</script>

<!-- SASIKUMAR AI Page Up / Down Tools -->
<div id="pageUpDownTools" style="
  position:fixed;
  right:14px;
  bottom:20px;
  z-index:9999;
  display:flex;
  flex-direction:column;
  gap:8px;
">
  <button onclick="window.scrollTo({top:0,behavior:'smooth'})"
    title="Go to Top"
    style="
      width:48px;
      height:48px;
      border-radius:50%;
      border:1px solid #ccc;
      font-size:22px;
      cursor:pointer;
      box-shadow:0 3px 10px rgba(0,0,0,.18);
    ">⬆️</button>

  <button onclick="window.scrollTo({top:document.body.scrollHeight,behavior:'smooth'})"
    title="Go to Bottom"
    style="
      width:48px;
      height:48px;
      border-radius:50%;
      border:1px solid #ccc;
      font-size:22px;
      cursor:pointer;
      box-shadow:0 3px 10px rgba(0,0,0,.18);
    ">⬇️</button>
</div>

<script>
function updateUpDownTools() {
  const tools = document.getElementById("pageUpDownTools");
  if (!tools) return;

  const nearTop = window.scrollY < 150;
  const nearBottom =
    window.innerHeight + window.scrollY >=
    document.documentElement.scrollHeight - 150;

  tools.style.opacity = (nearTop && nearBottom) ? "0.65" : "1";
}

window.addEventListener("scroll", updateUpDownTools);
window.addEventListener("resize", updateUpDownTools);
updateUpDownTools();
</script>
</body>
</html>
