function updateEducationFilters(){
  const c=document.getElementById("classFilter").value;
  const g=document.getElementById("groupFilter");

  if(c==="11th"){
    g.style.display="";
    [...g.options].forEach(o=>{
      o.hidden=!!o.value && !(o.value.startsWith("25") || o.value.startsWith("26"));
    });
  }else if(c==="12th"){
    g.style.display="";
    [...g.options].forEach(o=>{
      o.hidden=!!o.value && !o.value.startsWith("27");
    });
  }else{
    g.style.display="none";
    g.value="";
    [...g.options].forEach(o=>o.hidden=false);
  }

  updateSubjectFilter();
}

function updateSubjectFilter(){
  const c=document.getElementById("classFilter").value;
  const g=document.getElementById("groupFilter").value;
  const subjectFilter=document.getElementById("subjectFilter");

  let subjects=[];

  if(c==="11th" || c==="12th"){
    subjects=g && GROUPS[g]
      ? [...new Set(GROUPS[g])]
      : [...new Set(Object.values(GROUPS).flat())];
  }else{
    subjects=[
      "Tamil",
      "English",
      "Mathematics",
      "Science",
      "Social Science"
    ];
  }

  const current=subjectFilter.value;

  subjectFilter.innerHTML =
    '<option value="">All Subjects</option>' +
    subjects.map(x=>`<option>${x}</option>`).join('');

  subjectFilter.value=subjects.includes(current) ? current : '';
}

async function shareAnswer(i){
  const x=QA[i];
  const text=`${x.s}\nQ: ${x.q}\n\nAnswer: ${x.a}`;

  if(navigator.share){
    try{
      await navigator.share({title:"SASIKUMAR AI",text});
    }catch(e){}
  }else if(navigator.clipboard){
    await navigator.clipboard.writeText(text);
    alert("✅ Answer copied");
  }else{
    alert("📋 Copy is available by long-pressing the text.");
  }
}

