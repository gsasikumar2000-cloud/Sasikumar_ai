  if (!box) return "";
  return box.value;
}

function selectResultText() {
  const box = document.getElementById("resultEditBox");
  box.focus();
  box.select();
}

async function copyResultText() {
  const box = document.getElementById("resultEditBox");
  box.focus();
  box.select();

  try {
    await navigator.clipboard.writeText(box.value);
    alert("✅ Result copied");
  } catch (e) {
    document.execCommand("copy");
    alert("✅ Result copied");
  }
}

async function cutResultText() {
  const box = document.getElementById("resultEditBox");
  box.focus();
  box.select();

  try {
    await navigator.clipboard.writeText(box.value);
    box.value = "";
    alert("✂️ Result cut");
  } catch (e) {
    document.execCommand("cut");
    alert("✂️ Result cut");
  }
}

async function pasteResultText() {
  const box = document.getElementById("resultEditBox");
  box.focus();

  try {
    const text = await navigator.clipboard.readText();
    box.value += text;
    alert("📌 Pasted");
  } catch (e) {
    alert("📌 Please allow clipboard access");
  }
}

function saveResultText() {
  const text = getResultContent();

  if (!text.trim()) {
    alert("⚠️ Result is empty");
    return;
  }

  const blob = new Blob([text], {
    type: "text/plain;charset=utf-8"
  });

  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");

  a.href = url;
  a.download = "SASIKUMAR-AI-Result.txt";
  a.click();

  URL.revokeObjectURL(url);

  alert("💾 Result saved");
}
