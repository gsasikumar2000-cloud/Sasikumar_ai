<script>
function calcGold(){
  const w=Number(document.getElementById("goldWeight").value);
  const r=Number(document.getElementById("goldRate").value);

  if(w<=0 || r<=0){
    document.getElementById("goldResult").textContent =
      "Please enter valid weight and rate.";
    return;
  }

  const value=w*r;

  document.getElementById("goldResult").textContent =
    "🪙 Gold Value = ₹" +
    value.toLocaleString("en-IN",{maximumFractionDigits:2});
}

function calcEMI(){
  const P=Number(document.getElementById("loanP").value);
  const annual=Number(document.getElementById("loanR").value);
  const n=Number(document.getElementById("loanN").value);

  if(P<=0 || annual<0 || n<=0){
    document.getElementById("emiResult").textContent =
      "Please enter valid loan details.";
    return;
  }

  const r=annual/12/100;
  let emi;

  if(r===0){
    emi=P/n;
  }else{
    emi=P*r*Math.pow(1+r,n)/(Math.pow(1+r,n)-1);
  }

  const total=emi*n;
  const interest=total-P;

  document.getElementById("emiResult").innerHTML =
    "💳 Monthly EMI = ₹"+emi.toLocaleString("en-IN",{maximumFractionDigits:2})+
    "<br>💰 Total Payment = ₹"+total.toLocaleString("en-IN",{maximumFractionDigits:2})+
    "<br>📈 Total Interest = ₹"+interest.toLocaleString("en-IN",{maximumFractionDigits:2});
}
</script>


