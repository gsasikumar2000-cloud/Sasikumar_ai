<script>
(function(){

const levelEl = document.getElementById("studentLevel");
const subjectEl = document.getElementById("mathSubject");
const classEl = document.getElementById("mathClass");
const topicEl = document.getElementById("mathTopic");
const openBtn = document.getElementById("mathOpenBtn");
const infoEl = document.getElementById("mathSelectedInfo");
const detailsEl = document.getElementById("mathDetails");
const googleBtn = document.getElementById("mathGoogleBtn");

const levels = {
  primary: [1,2,3,4,5],
  middle: [6,7,8],
  secondary: [9,10],
  higher: [11,12]
};

const topics = {
"Mathematics": {
1:["Numbers","Counting","Addition","Subtraction","Shapes","Measurement","Time","Money"],
2:["Numbers","Addition","Subtraction","Multiplication","Division","Fractions","Shapes","Measurement","Time","Money"],
