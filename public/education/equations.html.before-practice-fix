12:["Relations and Functions","Inverse Trigonometric Functions","Matrices","Determinants","Continuity and Differentiability","Applications of Derivatives","Integrals","Applications of Integrals","Differential Equations","Vector Algebra","Three Dimensional Geometry","Linear Programming","Probability"]
},

"Physics": {
1:["Measurement","Motion","Push and Pull","Light","Sound"],
2:["Measurement","Motion","Light","Sound","Magnets"],
3:["Measurement","Motion","Energy","Light","Sound"],
4:["Force","Motion","Energy","Heat","Light","Sound"],
5:["Force and Motion","Energy","Light","Sound","Simple Machines"],
6:["Motion","Force","Energy","Light","Electricity"],
7:["Heat","Motion","Force","Pressure","Light","Sound"],
8:["Force","Pressure","Friction","Sound","Light","Electricity"],
9:["Motion","Force and Laws of Motion","Gravitation","Work and Energy","Sound"],
10:["Light","Human Eye","Electricity","Magnetic Effects of Electric Current","Sources of Energy"],
11:["Units and Measurements","Motion","Laws of Motion","Work Energy and Power","Gravitation","Thermodynamics","Oscillations","Waves"],
12:["Electric Charges and Fields","Electrostatic Potential","Current Electricity","Moving Charges and Magnetism","Electromagnetic Induction","Alternating Current","Ray Optics","Wave Optics","Atoms","Nuclei","Semiconductor Electronics"]
},

"Chemistry": {
1:["Materials","Water","Air","Changes"],
2:["Materials","Water","Air","Changes"],
3:["Materials Around Us","Water","Air","Changes"],
4:["Matter","Materials","Water","Air","Changes"],
5:["Matter","Materials","Water","Air","Separation"],
6:["Components of Food","Materials","Separation of Substances","Changes Around Us"],
7:["Matter","Physical and Chemical Changes","Acids and Bases","Heat"],
8:["Crop Production","Materials","Combustion","Coal and Petroleum","Chemical Effects"],
9:["Matter in Our Surroundings","Is Matter Around Us Pure","Atoms and Molecules","Structure of Atom"],
10:["Chemical Reactions","Acids Bases and Salts","Metals and Non-metals","Carbon Compounds","Periodic Classification"],
11:["Some Basic Concepts of Chemistry","Structure of Atom","Chemical Bonding","Thermodynamics","Equilibrium","Redox Reactions","Organic Chemistry"],
12:["Solutions","Electrochemistry","Chemical Kinetics","Surface Chemistry","Coordination Compounds","Haloalkanes","Alcohols Phenols Ethers","Amines","Biomolecules"]
},

"Computer Science": {
1:["Computer Basics","Parts of Computer","Keyboard","Mouse"],
2:["Computer Basics","Files","Typing","Drawing"],
3:["Hardware","Software","Internet Basics","Programming Basics"],
4:["Computer Networks","Internet","Algorithms","Programming"],
5:["Algorithms","Scratch","Internet Safety","Data"],
6:["Computer Basics","Algorithms","Programming","Internet"],
7:["Python Basics","Variables","Conditions","Loops","Functions"],
8:["Python","Lists","Functions","Algorithms","Cyber Safety"],
9:["Programming","Python","Data Structures","Computer Networks","Cyber Security"],
10:["Python","SQL","Data Structures","Networks","Cyber Security"],
11:["Computer Systems","Python","Data Structures","Database Concepts","Computer Networks"],
12:["Python","Data Structures","Database Management","Computer Networks","Computer Security"]
}
};

function resetAll(){
  classEl.innerHTML = '<option value="">Select Level & Subject first</option>';
  topicEl.innerHTML = '<option value="">Select Class first</option>';
  openBtn.disabled = true;
  detailsEl.style.display = "none";
  googleBtn.style.display = "none";
}

levelEl.addEventListener("change", function(){
  resetAll();

  if(!this.value || !subjectEl.value){
    infoEl.textContent = "Student Level → Subject → Class → Chapter / Topic";
    return;
  }

  loadClasses();
});

subjectEl.addEventListener("change", function(){
  resetAll();

  if(!this.value || !levelEl.value){
    infoEl.textContent = "Student Level → Subject → Class → Chapter / Topic";
    return;
  }

  loadClasses();
});

function loadClasses(){
  classEl.innerHTML = '<option value="">Select Class</option>';

  (levels[levelEl.value] || []).forEach(function(num){
    const option = document.createElement("option");
    option.value = "Class " + num;
    option.textContent = "Class " + num;
    classEl.appendChild(option);
  });

  infoEl.textContent =
    levelEl.options[levelEl.selectedIndex].text +
    " → " + subjectEl.value + " → Select Class";
}

classEl.addEventListener("change", function(){
  topicEl.innerHTML = '<option value="">Select Chapter / Topic</option>';

  const cls = this.value;
  const subject = subjectEl.value;

  if(!cls || !subject) return;

  const num = Number(cls.replace("Class ",""));
  const list = topics[subject]?.[num] || [];

  list.forEach(function(topic){
    const option = document.createElement("option");
    option.value = topic;
    option.textContent = topic;
    topicEl.appendChild(option);
  });

  openBtn.disabled = true;
  detailsEl.style.display = "none";
  googleBtn.style.display = "none";

  infoEl.textContent =
    cls + " → " + subject + " → Select Chapter / Topic";
});

topicEl.addEventListener("change", function(){
  const cls = classEl.value;
  const subject = subjectEl.value;
  const topic = this.value;

  openBtn.disabled = !(cls && subject && topic);

  if(cls && subject && topic){
    infoEl.textContent =
      "Selected: " + cls + " → " + subject + " → " + topic;
  }
});

window.openMathTopic = async function(){
  const level = levelEl.value;
  const subject = subjectEl.value;
  const cls = classEl.value;
  const topic = topicEl.value;

  if(!cls || !subject || !topic) return;

  detailsEl.style.display = "block";
  detailsEl.innerHTML = `
    <h3>📖 ${topic}</h3>
    <p><b>Student Level:</b> ${level || "School"}</p>
    <p><b>Class:</b> ${cls}</p>
    <p><b>Subject:</b> ${subject}</p>

    <div style="padding:14px;margin:12px 0;border-radius:10px;background:#f5f5f5;">
      🤖 <b>SASIKUMAR AI is preparing the topic explanation...</b>
      <br><small>தமிழ் + English • Examples • Formula • Step-by-step</small>
    </div>
  `;

  detailsEl.scrollIntoView({
    behavior:"smooth",
    block:"start"
  });

  try {
    const prompt = `
You are SASIKUMAR AI Education Tutor.

Explain this school mathematics topic for ${cls}, ${subject}, topic: ${topic}.

Give maximum useful educational detail suitable for the student's class.

IMPORTANT:
- Give Tamil explanation first.
- Then give clear English explanation.
- Use simple language.
- Explain the definition/concept.
- Give important rules.
- Give formulas/equations with symbols explained.
- Give at least 2 worked examples step-by-step.
- Give common mistakes.
- Give practical/real-life application where relevant.
- Give 5 practice questions.
- Give answers after the questions.
- End with a short revision summary.
- Do not invent an official textbook quotation.
- Keep mathematics accurate.
- Format with headings and bullet points.
`;

    const response = await fetch("/api/chat", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        message: prompt,
        source: "education-topic"
      })
    });

    if(!response.ok){
      throw new Error("AI request failed: HTTP " + response.status);
    }

    const rawResponse = await response.text();
        console.log("🤖 Q&A AI HTTP:", response.status, response.statusText);
        console.log("🤖 Q&A AI raw:", rawResponse);

        let data;
        try {
          data = JSON.parse(rawResponse);
        } catch (e) {
          throw new Error("Invalid JSON response from /api/chat");
        }

    const answer =
      data.reply ||
      data.response ||
      data.message ||
      data.answer ||
      "";

    if(!answer){
      throw new Error("Empty AI response");
    }

    const safeAnswer = String(answer)
      .replace(/&/g,"&amp;")
      .replace(/</g,"&lt;")
      .replace(/>/g,"&gt;")
      .replace(/\n/g,"<br>");

    detailsEl.innerHTML = `
      <h3>📖 ${topic}</h3>

      <p>
        <b>Student Level:</b> ${level || "School"}
        &nbsp; | &nbsp;
        <b>Class:</b> ${cls}
        &nbsp; | &nbsp;
        <b>Subject:</b> ${subject}
      </p>

      <div class="math-ai-explanation"
           style="margin-top:14px;padding:16px;border-radius:12px;background:#fff;border:1px solid #ddd;line-height:1.65;">
        <div style="font-size:18px;font-weight:700;margin-bottom:10px;">
          🤖 SASIKUMAR AI — Topic Explanation
        </div>
        ${safeAnswer}
      </div>

      <div style="margin-top:14px;padding:12px;border-radius:10px;background:#f5f5f5;">
        📚 <b>Learning:</b> Review the examples and try the practice questions before checking the answers.
      </div>

      <div style="margin-top:12px;">
        <button type="button"
          onclick="searchMathTopic()">
          🔎 Google Search – More Details
        </button>
      </div>
    `;

  } catch(error) {
    console.error("SASIKUMAR AI Topic Error:", error);

    detailsEl.innerHTML = `
      <h3>📖 ${topic}</h3>

      <p><b>Class:</b> ${cls}</p>
      <p><b>Subject:</b> ${subject}</p>

      <div style="padding:14px;border-radius:10px;background:#fff3cd;border:1px solid #ffe69c;">
        ⚠️ <b>AI explanation could not be loaded.</b>
        <br><br>
        ${String(error.message || error)}
      </div>

      <h4>📚 Topic Learning Guide</h4>
      <ul>
        <li>Definition / வரையறை</li>
        <li>Concept / கருத்து</li>
        <li>Rules / விதிகள்</li>
        <li>Formula / சூத்திரம்</li>
        <li>Worked Example / எடுத்துக்காட்டு</li>
        <li>Step-by-step Method / படிப்படியான முறை</li>
        <li>Practice Questions / பயிற்சி கேள்விகள்</li>
        <li>Answers / பதில்கள்</li>
        <li>Summary / சுருக்கம்</li>
      </ul>

      <button type="button" onclick="searchMathTopic()">
        🔎 Google Search – More Details
      </button>
    `;
  }
};

window.searchMathTopic = function(){

  const cls = classEl.value;
  const subject = subjectEl.value;
  const topic = topicEl.value;

  if(!cls || !subject || !topic) return;

  const query = encodeURIComponent(
    "SASIKUMAR AI " + cls + " " + subject + " " + topic +
    " Tamil English explanation formula examples"
  );

  window.open(
    "https://www.google.com/search?q=" + query,
    "_blank",
    "noopener,noreferrer"
  );
};

})();
</script>

