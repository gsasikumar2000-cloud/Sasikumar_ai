  const q = String(message || "");

  return /news|latest|today|current|breaking|search|information|price|rate|gold rate|weather|cricket|sports|Tamil Nadu|India|Tamil|Daily Thanthi|தினத்தந்தி|தமிழ்|தமிழ்நாடு|இந்தியா|செய்தி|இன்று|தற்போது|சமீபத்திய|நேரலை|தகவல்|தேடு|தேடல்|விலை|வானிலை|கிரிக்கெட்/i.test(q);
}

/* =====================================================
   CHAT API
===================================================== */

app.post("/api/chat", async (req, res) => {
  const message = String(req.body?.message || "").trim();

  if (!message) {
    return res.status(400).json({
      reply: "❗ தயவுசெய்து ஒரு கேள்வியை உள்ளிடுங்கள்."
    });
  }

  console.log("👤 Question:", message);

  /* ---------------------------------------------------
     1. Local deterministic answers first
  --------------------------------------------------- */

  const localAnswer = localGoldAnswer(message);

  if (localAnswer) {
    console.log("🪙 Local Gold Answer");

    return res.json({
      reply: localAnswer,
      source: "local"
    });
  }

  /* ---------------------------------------------------
     2. Current / News / Search → Tavily
  --------------------------------------------------- */

  if (needsWebSearch(message)) {
    console.log("🌐 Tavily Web Search");

    const webResult = await webSearch(message);

    if (webResult) {
      return res.json({
        reply: webResult,
        source: "web"
      });
    }

    console.log("⚠️ Tavily did not return result");
  }

  /* ---------------------------------------------------
     3. Gemini AI
  --------------------------------------------------- */

  try {
    console.log("🤖 Gemini AI");

    const answer = await askGemini(message);

    return res.json({
      reply: answer,
      source: "gemini"
    });

  } catch (error) {
    console.error("Gemini Error:", error.message);

    const msg = String(error?.message || "").toLowerCase();

    /* -------------------------------------------------
       Gemini quota / 429 → Tavily fallback
    ------------------------------------------------- */

    if (
      error?.status === 429 ||
      msg.includes("429") ||
      msg.includes("quota") ||
      msg.includes("resource exhausted")
    ) {
      console.log("🔄 Gemini quota → Tavily fallback");

      const webResult = await webSearch(message);

      if (webResult) {
        return res.json({
          reply:
            webResult +
            "\n\nℹ️ Gemini quota காரணமாக Web Search fallback பயன்படுத்தப்பட்டது.",
          source: "web-fallback"
        });
      }

      return res.json({
        reply:
          "⚠️ Gemini AI quota தற்போது முடிந்துள்ளது.\n\n" +
          "🌐 Web Search-லும் பதில் கிடைக்கவில்லை.\n\n" +
          "சிறிது நேரம் கழித்து மீண்டும் முயற்சிக்கவும்.",
        source: "quota"
      });
    }

    /* -------------------------------------------------
       Other Gemini error → Tavily fallback
    ------------------------------------------------- */

    console.log("🔄 Gemini error → Tavily fallback");

    const webResult = await webSearch(message);

    if (webResult) {
      return res.json({
        reply:
          webResult +
          "\n\nℹ️ Gemini unavailable → Web Search fallback.",
        source: "web-fallback"
      });
    }

    return res.json({
      reply:
        "❌ SASIKUMAR AI தற்போது பதில் வழங்க முடியவில்லை.\n\n" +
        "சிறிது நேரம் கழித்து மீண்டும் முயற்சிக்கவும்.",
      source: "error"
    });
  }
});

