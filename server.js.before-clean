require("dotenv").config();

const express = require("express");
const path = require("path");

const app = express();
const PORT = 3000;

app.use(express.json());
app.use(express.static(path.join(__dirname, "public")));

function localGoldAnswer(message) {
  const q = message.toLowerCase().trim();

  if (
    q.includes("22k") ||
    q.includes("22ct") ||
    q.includes("22 காரட்") ||
    q.includes("22 carat")
    if (q.includes("density") || q.includes("அடர்த்தி") || q.includes("specific gravity")) {
      if (q.includes("22k") || q.includes("22ct") || q.includes("22 carat") || q.includes("22 காரட்")) {
        return "22K / 916 Gold density பொதுவாக சுமார் 17.5–17.8 g/cm³. Alloy composition மற்றும் jewellery construction காரணமாக actual density மாறலாம்.";
      }
    }

  ) {
    return "22K / 22CT தங்கம் பொதுவாக 91.6% தூய தங்கத்தை குறிக்கும். 916 என்பது 22K gold-ன் fineness குறியீடு.";
  }

  if (
    q.includes("19k") ||
    q.includes("19ct") ||
    q.includes("19 காரட்") ||
    q.includes("19 carat")
  ) {
    return "19K / 19CT தங்கத்தில் தூய தங்கம் சுமார் 79.2% இருக்கும். இதன் fineness சுமார் 792.";
  }

  if (
    q.includes("18k") ||
    q.includes("18ct") ||
    q.includes("18 காரட்") ||
    q.includes("18 carat")
  ) {
    return "18K / 18CT தங்கத்தில் தூய தங்கம் 75% இருக்கும். இதன் fineness 750.";
  }

  if (
    q.includes("24k") ||
    q.includes("24ct") ||
    q.includes("24 காரட்") ||
    q.includes("24 carat")
  ) {
    return "24K தங்கம் மிக உயர்ந்த purity grade ஆகும். பொதுவாக 99.9% purity என்று குறிப்பிடப்படுகிறது.";
  }

  if (q.includes("hallmark") || q.includes("916")) {
    return "Hallmark 916 என்பது 22K gold-ன் fineness குறியீடு. 916 = 91.6% gold.";
  }

  return null;
}

let quotaBlockedUntil = 0;

app.post("/api/chat", async (req, res) => {
  const message = String(req.body?.message || "").trim();

  if (!message) {
    return res.status(400).json({
      error: "கேள்வியை உள்ளிடுங்கள்."
    });
  }

  // முதலில் LOCAL answer
  const localReply = localGoldAnswer(message);

  if (localReply) {
    console.log("LOCAL ANSWER:", message);

    return res.json({
      reply: localReply,
      source: "local"
    });
  }

  // Quota block
  if (Date.now() < quotaBlockedUntil) {
    return res.json({
      reply: "⚠️ Gemini API quota தற்போது முடிந்துள்ளது. சிறிது நேரம் கழித்து மீண்டும் முயற்சிக்கவும்.",
      source: "quota"
    });
  }

  const apiKey = process.env.GEMINI_API_KEY;

  if (!apiKey) {
    return res.status(500).json({
      error: "GEMINI_API_KEY அமைக்கப்படவில்லை."
    });
  }

  try {
    const response = await fetch(
      "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent",
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-goog-api-key": apiKey
        },
        body: JSON.stringify({
          contents: [
            {
              parts: [
                {
                  text:
                    "You are SASIKUMAR AI. Answer clearly in Tamil when appropriate.\n\nUser: " +
                    message
                }
              ]
            }
          ]
        })
      }
    );

    const data = await response.json();

    if (!response.ok) {
      const errorText =
        data?.error?.message || "Gemini API error";

      if (
        response.status === 429 ||
        errorText.toLowerCase().includes("quota")
      ) {
        quotaBlockedUntil = Date.now() + 60000;

        return res.json({
          reply: "⚠️ Gemini API quota முடிந்துவிட்டது. 60 விநாடிகளுக்கு API request நிறுத்தப்பட்டுள்ளது.",
          source: "quota"
        });
      }

      return res.status(response.status).json({
        error: errorText
      });
    }

    const reply =
      data?.candidates?.[0]?.content?.parts
        ?.map(p => p.text || "")
        .join("") || "பதில் கிடைக்கவில்லை.";

    return res.json({
      reply,
      source: "gemini"
    });

  } catch (error) {
    console.error("API ERROR:", error);

    return res.status(500).json({
      error: "Server/API connection error."
    });
  }
});


app.listen(PORT, "0.0.0.0", () => {
  console.log(`SASIKUMAR AI running at http://localhost:${PORT}`);
});
