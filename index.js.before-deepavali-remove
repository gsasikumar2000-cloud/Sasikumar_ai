// --------------------------------------------------
// Utility: draw a filled circle
// --------------------------------------------------
function drawCircle(image, cx, cy, radius, color) {
  const r2 = radius * radius;

  const startX = Math.max(0, cx - radius);
  const endX = Math.min(image.bitmap.width - 1, cx + radius);
  const startY = Math.max(0, cy - radius);
  const endY = Math.min(image.bitmap.height - 1, cy + radius);

  image.scan(
    startX,
    startY,
    endX - startX + 1,
    endY - startY + 1,
    function (x, y, idx) {
      const dx = x - cx;
      const dy = y - cy;

      if (dx * dx + dy * dy <= r2) {
        this.bitmap.data[idx] = (color >> 24) & 255;
        this.bitmap.data[idx + 1] = (color >> 16) & 255;
        this.bitmap.data[idx + 2] = (color >> 8) & 255;
        this.bitmap.data[idx + 3] = color & 255;
      }
    }
  );
}

// --------------------------------------------------
// Utility: draw a simple diya
// --------------------------------------------------
function drawDiya(image, centerX, centerY) {

  // Diya bowl
  image.scan(
    centerX - 230,
    centerY,
    460,
    150,
    function (x, y, idx) {

      const dx = Math.abs(x - centerX);
      const dy = y - centerY;

      const width = 230 - Math.floor(dy * 1.1);

      if (width > 0 && dx < width) {
        this.bitmap.data[idx] = 190;
        this.bitmap.data[idx + 1] = 105;
        this.bitmap.data[idx + 2] = 15;
        this.bitmap.data[idx + 3] = 255;
      }
    }
  );

  // Oil area
  drawCircle(
    image,
    centerX,
    centerY + 15,
    115,
    0x5A2600FF
  );

  // Flame outer
  drawCircle(
    image,
    centerX,
    centerY - 100,
    65,
    0xFF8C00FF
  );

  // Flame inner
  drawCircle(
    image,
    centerX,
    centerY - 105,
    38,
    0xFFF2A600
  );

  // Flame tip
  image.scan(
    centerX - 30,
    centerY - 175,
    60,
    70,
    function (x, y, idx) {
      const dx = x - centerX;
      const dy = y - (centerY - 145);

      if (
        (dx * dx) / 900 +
        (dy * dy) / 4900 < 1
      ) {
        this.bitmap.data[idx] = 255;
        this.bitmap.data[idx + 1] = 210;
        this.bitmap.data[idx + 2] = 40;
        this.bitmap.data[idx + 3] = 255;
      }
    }
  );
}

// --------------------------------------------------
// Create Deepavali poster
// --------------------------------------------------
async function createDeepavaliPoster(customMessage) {

  const WIDTH = 1080;
  const HEIGHT = 1350;

  // Create warm background
  const image = new Jimp(
    WIDTH,
    HEIGHT,
    0x8A1600FF
  );

  // Vertical orange/gold gradient
  image.scan(
    0,
    0,
    WIDTH,
    HEIGHT,
    function (x, y, idx) {

      const ratio = y / HEIGHT;

      const red = Math.floor(255 - ratio * 70);
      const green = Math.floor(120 + ratio * 65);
      const blue = Math.floor(10 + ratio * 20);

      this.bitmap.data[idx] = red;
      this.bitmap.data[idx + 1] = green;
      this.bitmap.data[idx + 2] = blue;
      this.bitmap.data[idx + 3] = 255;
    }
  );

  // Fonts
  const titleFont =
    await Jimp.loadFont(Jimp.FONT_SANS_64_WHITE);

  const smallFont =
    await Jimp.loadFont(Jimp.FONT_SANS_32_WHITE);

  const tinyFont =
    await Jimp.loadFont(Jimp.FONT_SANS_16_WHITE);

  // ------------------------------------------------
  // Decorative golden sparkles
  // ------------------------------------------------
  const sparkles = [
    [100, 150],
    [970, 150],
    [160, 330],
    [920, 320],
    [80, 620],
    [1000, 620],
    [130, 900],
    [950, 900],
    [70, 1120],
    [1010, 1120]
  ];

  for (const [x, y] of sparkles) {
    drawCircle(
      image,
      x,
      y,
      9,
      0xFFF0A0FF
    );

    drawCircle(
      image,
      x,
      y,
      3,
      0xFFFFFFFF
    );
  }

  // ------------------------------------------------
  // Top heading
  // ------------------------------------------------
  image.print(
    smallFont,
    0,
    95,
    {
      text: '✨ FESTIVAL OF LIGHTS ✨',
      alignmentX: Jimp.HORIZONTAL_ALIGN_CENTER
    },
    WIDTH
  );

  // ------------------------------------------------
  // Main title
  // ------------------------------------------------
  image.print(
    titleFont,
    0,
    190,
    {
      text: 'HAPPY',
      alignmentX: Jimp.HORIZONTAL_ALIGN_CENTER
    },
    WIDTH
  );

  image.print(
    titleFont,
    0,
    275,
    {
      text: 'DEEPAVALI',
      alignmentX: Jimp.HORIZONTAL_ALIGN_CENTER
    },
    WIDTH
  );

  // ------------------------------------------------
  // Sub heading
  // ------------------------------------------------
  image.print(
    smallFont,
    0,
    390,
    {
      text: 'Light • Joy • Prosperity',
      alignmentX: Jimp.HORIZONTAL_ALIGN_CENTER
