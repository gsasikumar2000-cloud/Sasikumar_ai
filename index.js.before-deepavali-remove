      960,
      180
    );
  }

  // ------------------------------------------------
  // Central Diya
  // ------------------------------------------------
  drawDiya(
    image,
    WIDTH / 2,
    735
  );

  // ------------------------------------------------
  // Decorative small diyas
  // ------------------------------------------------
  drawCircle(
    image,
    240,
    850,
    35,
    0xFFB020FF
  );

  drawCircle(
    image,
    240,
    810,
    18,
    0xFFF5A000
  );

  drawCircle(
    image,
    840,
    850,
    35,
    0xFFB020FF
  );

  drawCircle(
    image,
    840,
    810,
    18,
    0xFFF5A000
  );

  // ------------------------------------------------
  // Celebration message
  // ------------------------------------------------
  image.print(
    smallFont,
    40,
    930,
    {
