app.post("/api/chat", async (req, res) => {
  try {
    const message = String(req.body?.message || "").trim();

    if (!message) {
      return res.status(400).json({
        error: "Message is required"
      });
    }

    const localAnswer = localGoldAnswer(message);

    if (localAnswer) {
      return res.json({
        reply: localAnswer,
        source: "local"
      });
    }

    return res.json({
      reply: "SASIKUMAR AI: உங்கள் கேள்வியைப் புரிந்துகொண்டேன். Gemini AI connection தயாராக உள்ளது.",
      source: "local"
    });

  } catch (error) {
    console.error(error);
    res.status(500).json({
      error: "Server error"
    });
  }
});

app.get("/", (req, res) => {
  res.sendFile(path.join(__dirname, "public", "index.html"));
});

app.listen(PORT, "0.0.0.0", () => {
  console.log(`SASIKUMAR AI running at http://localhost:${PORT}`);
});
