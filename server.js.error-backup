require("dotenv").config();

const express = require("express");
const path = require("path");

const app = express();
const PORT = 3000;

app.use(express.json());
app.use(express.static(path.join(__dirname, "public")));

function localGoldAnswer(message) {
  const q = message.toLowerCase().trim();

  // DENSITY FIRST
  if (
    q.includes("density") ||
    q.includes("அடர்த்தி") ||
    q.includes("specific gravity")
  ) {
    if (
      q.includes("22k") ||
      q.includes("22ct") ||
      q.includes("22 carat") ||
      q.includes("22 காரட்")
    ) {
      return "22K / 916 Gold density பொதுவாக சுமார் 17.5–17.8 g/cm³.";
    }

    if (
      q.includes("24k") ||
      q.includes("24ct") ||
      q.includes("24 carat") ||
      q.includes("24 காரட்")
    ) {
      return "24K pure gold density சுமார் 19.3 g/cm³.";
    }

    if (
      q.includes("21k") ||
      q.includes("21ct") ||
      q.includes("21 carat") ||
      q.includes("21 காரட்")
    ) {
      return "21K gold density பொதுவாக சுமார் 16.8–17.3 g/cm³.";
    }

    if (
      q.includes("18k") ||
      q.includes("18ct") ||
      q.includes("18 carat") ||
      q.includes("18 காரட்")
    ) {
      return "18K gold density பொதுவாக சுமார் 15.2–15.9 g/cm³.";
    }
  }

  // 22K
  if (
    q.includes("22k") ||
    q.includes("22ct") ||
    q.includes("22 காரட்") ||
    q.includes("22 carat")
  ) {
    return "22K / 22CT தங்கம் பொதுவாக 91.6% தூய தங்கத்தை குறிக்கும். 916 என்பது 22K gold-ன் fineness குறியீடு.";
  }


  const q = message.toLowerCase().trim();

  // DENSITY
  if (
    q.includes("density") ||
    q.includes("அடர்த்தி") ||
    q.includes("specific gravity")
  ) {
    if (
      q.includes("22k") ||
      q.includes("22ct") ||
      q.includes("22 carat") ||
      q.includes("22 காரட்")
    ) {
      return "22K / 916 Gold density பொதுவாக சுமார் 17.5–17.8 g/cm³.";
    }

    if (
      q.includes("24k") ||
      q.includes("24ct") ||
      q.includes("24 carat") ||
      q.includes("24 காரட்")
    ) {
      return "24K pure gold density சுமார் 19.3 g/cm³.";
    }

    if (
      q.includes("21k") ||
      q.includes("21ct") ||
      q.includes("21 carat") ||
      q.includes("21 காரட்")
    ) {
      return "21K gold density பொதுவாக சுமார் 16.8–17.3 g/cm³.";
    }

    if (
      q.includes("18k") ||
      q.includes("18ct") ||
      q.includes("18 carat") ||
      q.includes("18 காரட்")
    ) {
      return "18K gold density பொதுவாக சுமார் 15.2–15.9 g/cm³.";
    }
  }

  // 22K
  if (
    q.includes("22k") ||
    q.includes("22ct") ||
    q.includes("22 காரட்") ||
    q.includes("22 carat")
  ) {
    return "22K / 22CT தங்கம் பொதுவாக 91.6% தூய தங்கத்தை குறிக்கும். 916 என்பது 22K gold-ன் fineness குறியீடு.";
  }

  // 19K
  if (
    q.includes("19k") ||
    q.includes("19ct") ||
    q.includes("19 காரட்") ||
    q.includes("19 carat")
  ) {
    return "19K / 19CT தங்கத்தில் தூய தங்கம் சுமார் 79.2% இருக்கும். இதன் fineness சுமார் 792.";
  }

  // 18K
  if (
    q.includes("18k") ||
    q.includes("18ct") ||
    q.includes("18 காரட்") ||
    q.includes("18 carat")
  ) {
