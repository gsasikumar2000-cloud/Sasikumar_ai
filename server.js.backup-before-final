app.post("/api/chat", async (req, res) => {
  const message = String(req.body?.message || "").trim();

  if (!message) {
    return res.status(400).json({
      reply: "❗ தயவுசெய்து ஒரு கேள்வியை உள்ளிடுங்கள்."
    });
  }

  console.log("👤 Question:", message);

  const webKeywords = /news|latest|today|current|breaking|செய்தி|இன்று|தற்போது|சமீபத்திய|நேரலை/i;

  if (webKeywords.test(message)) {
    console.log("🌐 Tavily Web Search");
    const webResult = await webSearch(message);

    if (webResult) {
      return res.json({
        reply: webResult,
        source: "web"
      });
    }
  }

  const localAnswer = localGoldAnswer(message);

  if (localAnswer) {
    console.log("🪙 Local Gold Answer");
    return res.json({
      reply: localAnswer,
      source: "local"
    });
  }

  try {
    console.log("🤖 Gemini AI");
    const answer = await askGemini(message);

    return res.json({
      reply: answer,
      source: "gemini"
    });

  } catch (error) {
    console.error("Gemini Error:", error.message);

    const msg = String(error?.message || "").toLowerCase();

    if (
      error?.status === 429 ||
      msg.includes("429") ||
      msg.includes("quota exceeded")
    ) {
      const webResult = await webSearch(message);
      if (webResult) {
        return res.json({ reply: webResult, source: "web" });
      }

      return res.json({
        reply: "⚠️ Gemini quota முடிந்துள்ளது. Web Search-லும் தற்போது பதில் கிடைக்கவில்லை.",
        source: "quota"
      });
    }

    return res.json({
      reply:
        "❌ Gemini AI தற்போது பதில் வழங்க முடியவில்லை.\n\n" +
        "சிறிது நேரம் கழித்து மீண்டும் முயற்சிக்கவும்.",
      source: "error"
    });
  }
});

