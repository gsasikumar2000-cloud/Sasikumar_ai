let geminiClient = null;

async function askGemini(message) {
  if (!process.env.GEMINI_API_KEY) {
    throw new Error("GEMINI_API_KEY missing");
  }

  if (!geminiClient) {
    const { GoogleGenAI } = await import("@google/genai");

    geminiClient = new GoogleGenAI({
      apiKey: process.env.GEMINI_API_KEY
    });
  }

  const response = await geminiClient.interactions.create({
    model: "gemini-3.8-flash",
    input: message,
    tools: [
      { type: "google_search" }
    ],
  });

  return response.output_text || "பதில் கிடைக்கவில்லை.";
}




async function webSearch(query) {
  try {
    if (!process.env.TAVILY_API_KEY) {
      console.log("⚠️ TAVILY_API_KEY missing");
      return null;
    }

    const tvly = tavily({
      apiKey: process.env.TAVILY_API_KEY
    });

    const response = await tvly.search(query, {
      search_depth: "basic",
      max_results: 5,
      include_answer: true
    });

    if (response.answer) {
      return "🌐 Tavily Web Search:\n\n" + response.answer;
    }

    if (!response.results || response.results.length === 0) {
      return null;
    }

    return "🌐 Tavily Web Search Results:\n\n" +
      response.results.slice(0, 5).map((r, i) =>
        `${i + 1}. ${r.title}\n${r.content || ""}\n${r.url}`
      ).join("\n\n");

  } catch (error) {
    console.error("Tavily Error:", error.message);
    return null;
  }
}

